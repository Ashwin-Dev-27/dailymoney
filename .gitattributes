# Normalize line endings so the repository is consistent across Windows,
# macOS and Linux. Git stores LF internally; Windows scripts keep CRLF.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
*.jks binary
*.apk binary
