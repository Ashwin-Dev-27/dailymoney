# ---------------------------------------------------------------
# Secrets and signing material — never commit these
# ---------------------------------------------------------------
**/key.properties
**/*.jks
**/*.keystore
**/*.p12
**/google-services.json
**/.env
**/.env.*

# ---------------------------------------------------------------
# Build output and caches (regenerated by Flutter / Gradle / npm)
# ---------------------------------------------------------------
**/build/
**/.dart_tool/
**/node_modules/
**/.gradle/
**/.kotlin/
**/.cxx/
**/.externalNativeBuild/
**/local.properties
**/*.apk
**/*.aab
**/*.symbols
**/*.map.json

# ---------------------------------------------------------------
# IDE and OS files
# ---------------------------------------------------------------
**/.idea/
**/*.iml
**/*.ipr
**/*.iws
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# Logs and local debug output
# ---------------------------------------------------------------
*.log
